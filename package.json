{
  "name": "fastygo-blank",
  "private": true,
  "packageManager": "bun@1.3.3",
  "dependencies": {
    "@ui8kit/aria": "^0.1.0"
  },
  "scripts": {
    "build:css": "bun scripts/build-css.mjs",
    "build:js": "node scripts/build-js.mjs",
    "build:dev-overlay": "node scripts/build-dev-overlay.mjs",
    "dev": "bun run build:css && bun run build:js && bun run build:dev-overlay && bash ./scripts/dev.sh",
    "g": "bun run dev",
    "retag": "bash ./scripts/retag-check.sh",
    "test": "bash ./scripts/test.sh",
    "config": "bun scripts/config-get.mjs --json",
    "templ": "templ generate ./...",
    "verify": "bun run templ && bun run build:css && bun run build:js && bun run retag && go test ./..."
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.1",
    "tailwindcss": "^4.3.1"
  }
}
