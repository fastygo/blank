package views

import (
	"github.com/fastygo/blank/internal/fixtures"
	"github.com/fastygo/blank/internal/kit/ui/box"
	"github.com/fastygo/blank/internal/kit/ui/text"
	"github.com/fastygo/blank/internal/kit/ui/title"
	"github.com/fastygo/blank/internal/ui/layout"
)

// SamplePage composes RootLayout + DashboardLayout with the page body.
// This file is the entire layout picture for `/sample` — open it once and
// you see DashboardLayout + content, like app/dashboard/page.tsx.
templ SamplePage(d layout.Data, f fixtures.Locale) {
	@layout.RootLayout(d.Document()) {
		@layout.DashboardLayout(d.Dashboard(f.Sample.Title)) {
			@box.Box(box.BoxProps{Class: "flex flex-1 flex-col items-center justify-center px-4 py-16 text-center md:py-24"}) {
				@box.Box(box.BoxProps{Class: "flex w-full max-w-md flex-col items-center gap-3 text-center"}) {
					@title.Title(title.TitleProps{As: 1, Class: "text-3xl font-bold tracking-tight"}) {
						{ f.Sample.Title }
					}
					@text.Text(text.TextProps{Class: "text-base text-muted-foreground"}) {
						{ f.Sample.Description }
					}
					@text.Text(text.TextProps{Class: "text-sm leading-relaxed text-muted-foreground"}) {
						{ f.Sample.Body }
					}
				}
			}
		}
	}
}
