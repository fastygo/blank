package views

import (
	"github.com/fastygo/blank/internal/ui/layout"
	"github.com/fastygo/templ/ui"
)

const loginFormAction = "/cabinet/login"

templ LoginPage(d LoginPageData) {
	@layout.Shell(LoginShellProps(d)) {
		@ui.Stack(ui.StackProps{Class: "mx-auto flex max-w-md flex-col gap-6 py-12"}) {
			@ui.Title(ui.TitleProps{Order: 1}, d.Title)
			@ui.Text(ui.TextProps{Class: "text-sm text-muted-foreground"}, d.Subtitle)
			if d.Error != "" {
				@ui.Text(ui.TextProps{Class: "text-sm text-destructive"}, d.Error)
			}
			@ui.Form(ui.FormProps{Action: loginFormAction, Method: "post", Class: "flex flex-col gap-4"}) {
				if d.ReturnTo != "" {
					@ui.Input(ui.InputProps{Type: "hidden", Name: "return_to", Value: d.ReturnTo})
				}
				@ui.FormItem(ui.FormItemProps{}) {
					@ui.Label(ui.LabelProps{HTMLFor: "login-email"}) {
						{ d.EmailLabel }
					}
					@ui.Input(ui.InputProps{
						ID:           "login-email",
						Type:         "email",
						Name:         "email",
						Placeholder:  d.EmailLabel,
						Required:     true,
						Autocomplete: "username",
					})
				}
				@ui.FormItem(ui.FormItemProps{}) {
					@ui.Label(ui.LabelProps{HTMLFor: "login-password"}) {
						{ d.PasswordLabel }
					}
					@ui.Input(ui.InputProps{
						ID:           "login-password",
						Type:         "password",
						Name:         "password",
						Required:     true,
						Autocomplete: "current-password",
					})
				}
				@ui.Button(ui.ButtonProps{
					Type:    "submit",
					Variant: "default",
					Class:   "w-full",
				}) {
					{ d.SubmitLabel }
				}
			}
		}
	}
}
