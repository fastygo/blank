package ui

templ Host(props HostProps) {
	<script id="fastygo-dev-overlay-loader" data-request-id={ props.RequestID } data-i18n={ props.PanelJSON }>
		(() => {
			const currentScript = document.currentScript;
			if (!currentScript) return;
			window.__FASTYGO_DEV_OVERLAY__ = {
				requestId: currentScript.dataset.requestId || "",
				i18n: currentScript.dataset.i18n || "",
			};
			if (window.matchMedia?.("(max-width: 767px)").matches) return;
			if (window.__FASTYGO_DEV_OVERLAY_MOUNT__) {
				window.__FASTYGO_DEV_OVERLAY_MOUNT__();
				return;
			}
			if (document.querySelector("script[data-fastygo-dev-overlay-bundle]")) return;

			const script = document.createElement("script");
			script.async = false;
			script.src = "/__fastygo/dev/overlay.js";
			script.dataset.fastygoDevOverlayBundle = "";
			script.dataset.requestId = currentScript.dataset.requestId || "";
			script.dataset.i18n = currentScript.dataset.i18n || "";
			script.onload = () => window.__FASTYGO_DEV_OVERLAY_MOUNT__?.();
			currentScript.after(script);
		})();
	</script>
}
