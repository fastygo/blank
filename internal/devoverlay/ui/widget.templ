package ui

import "github.com/fastygo/templ/ui"

templ Host(requestID string) {
	<div id="fastygo-dev-overlay-root" class="fixed bottom-4 right-4 z-[9999]">
		@ui.Button(ui.ButtonProps{
			ID:        "fastygo-dev-launcher",
			Type:      "button",
			Variant:   "ghost",
			Size:      "icon",
			AriaLabel: "Open FastyGo dev overlay",
			Class:     "rounded-full",
			Attrs: templ.Attributes{
				"aria-controls": "fastygo-dev-panel",
				"aria-expanded": "false",
			},
		}) {
			@cogIcon()
		}
		@ui.Box(ui.BoxProps{
			Tag:   "section",
			Class: "fixed bottom-16 right-4 hidden max-h-[min(80vh,640px)] w-[min(92vw,420px)] overflow-auto rounded-lg border border-border bg-card p-4 text-card-foreground shadow-lg",
			Attrs: templ.Attributes{
				"id":         "fastygo-dev-panel",
				"role":       "region",
				"aria-label": "FastyGo dev overlay",
			},
		}) {
			@ui.Stack(ui.StackProps{Class: "gap-4 w-full"}) {
				@ui.Title(ui.TitleProps{Order: 2}, "FastyGo Dev")
				@ui.Text(ui.TextProps{Tag: "small", Class: "text-muted-foreground"}, "Server status for local development.")
				@ui.Box(ui.BoxProps{
					Tag:   "div",
					Class: "flex flex-wrap gap-2",
					Attrs: templ.Attributes{
						"role":       "tablist",
						"aria-label": "FastyGo dev panels",
					},
				}) {
					@tabButton("health", "Health", true)
					@tabButton("assets", "Assets", false)
					@tabButton("request", "Request", false)
				}
				@tabPanel("health", "Health", true)
				@tabPanel("assets", "Assets", false)
				@tabPanel("request", "Request", false)
				@ui.Separator(ui.SeparatorProps{Decorative: true})
				@ui.Button(ui.ButtonProps{
					ID:        "fastygo-dev-hide",
					Type:      "button",
					Variant:   "outline",
					Size:      "sm",
					AriaLabel: "Hide dev overlay",
				}) {
					Hide overlay
				}
			}
		}
	</div>
	<script defer src="/__fastygo/dev/overlay.js" data-request-id={ requestID }></script>
}

templ cogIcon() {
	@ui.Icon(ui.IconProps{
		Type:       "svg",
		Size:       "sm",
		Class:      "h-5 w-5",
		Decorative: true,
		Attrs: templ.Attributes{
			"xmlns":           "http://www.w3.org/2000/svg",
			"viewBox":         "0 0 24 24",
			"fill":            "none",
			"stroke":          "currentColor",
			"stroke-width":    "2",
			"stroke-linecap":  "round",
			"stroke-linejoin": "round",
		},
	}) {
		<path d="M11 10.27 7 3.34"></path>
		<path d="m11 13.73-4 6.93"></path>
		<path d="M12 22v-2"></path>
		<path d="M12 2v2"></path>
		<path d="M14 12h8"></path>
		<path d="m17 20.66-1-1.73"></path>
		<path d="m17 3.34-1 1.73"></path>
		<path d="M2 12h2"></path>
		<path d="m20.66 17-1.73-1"></path>
		<path d="m20.66 7-1.73 1"></path>
		<path d="m3.34 17 1.73-1"></path>
		<path d="m3.34 7 1.73 1"></path>
		<circle cx="12" cy="12" r="2"></circle>
		<circle cx="12" cy="12" r="8"></circle>
	}
}

templ tabButton(id string, label string, selected bool) {
	@ui.Button(ui.ButtonProps{
		ID:      "fastygo-dev-tab-" + id,
		Type:    "button",
		Variant: tabVariant(selected),
		Size:    "sm",
		Attrs: tabButtonAttrs(id, label, selected),
	}) {
		{ label }
	}
}

templ tabPanel(id string, label string, selected bool) {
	@ui.Box(ui.BoxProps{
		Tag:   "section",
		Class: "gap-3",
		Attrs: tabPanelAttrs(id, label, selected),
	}) {
		@ui.Text(ui.TextProps{Tag: "small", Class: "text-muted-foreground"}, "Loading "+ label + "…")
		<div id={ "fastygo-dev-panel-" + id } class="flex flex-col gap-2"></div>
	}
}

func tabVariant(selected bool) string {
	if selected {
		return "default"
	}
	return "ghost"
}

func tabButtonAttrs(id, label string, selected bool) templ.Attributes {
	attrs := templ.Attributes{
		"role":               "tab",
		"type":               "button",
		"aria-controls":      "fastygo-dev-panel-" + id,
		"data-dev-tab":       id,
		"data-dev-tab-label": label,
	}
	if selected {
		attrs["aria-selected"] = "true"
	} else {
		attrs["aria-selected"] = "false"
	}
	return attrs
}

func tabPanelAttrs(id, label string, selected bool) templ.Attributes {
	attrs := templ.Attributes{
		"role":                 "tabpanel",
		"id":                   "fastygo-dev-panel-wrap-" + id,
		"aria-labelledby":      "fastygo-dev-tab-" + id,
		"data-dev-panel":       id,
		"data-dev-panel-label": label,
	}
	if selected {
		attrs["data-dev-panel-active"] = "true"
	} else {
		attrs["hidden"] = true
		attrs["data-dev-panel-active"] = "false"
	}
	return attrs
}
