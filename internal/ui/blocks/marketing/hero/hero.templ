package hero

import (
	"github.com/fastygo/blank/internal/kit/ui/box"
	"github.com/fastygo/blank/internal/kit/ui/text"
	"github.com/fastygo/blank/internal/kit/ui/title"
)

// Hero renders the marketing hero section (welcome line, title, description).
templ Hero(props Props) {
	@box.Box(box.BoxProps{Class: "flex flex-1 flex-col items-center justify-center px-4 py-16 text-center md:py-24"}) {
		@box.Box(box.BoxProps{Class: "flex w-full max-w-md flex-col items-center gap-3 text-center"}) {
			@text.Text(text.TextProps{Class: "text-sm uppercase tracking-wide text-muted-foreground"}) {
				{ props.Welcome }
			}
			@title.Title(title.TitleProps{As: 1, Class: "text-4xl font-bold tracking-tight md:text-5xl"}) {
				{ props.WelcomeBrand }
			}
			@text.Text(text.TextProps{Class: "text-base leading-relaxed text-muted-foreground md:text-lg"}) {
				{ props.Description }
			}
		}
	}
}
