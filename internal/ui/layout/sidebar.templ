package layout

import (
	"github.com/fastygo/templ/ui"
	"github.com/fastygo/blank/internal/ui/components/icon"
)

templ Sidebar(props SidebarProps) {
	for _, item := range props.Items {
		@sidebarNavLink(props.Active, item)
	}
}

templ sidebarNavLink(active string, item NavItem) {
	@ui.Button(sidebarLinkButtonProps(active, item)) {
		if item.Icon != "" {
			@icon.Icon(icon.IconProps{Name: item.Icon, Size: "sm"})
		}
		@ui.Text(ui.TextProps{Tag: "span", Class: "min-w-0"}, item.Label)
	}
}
