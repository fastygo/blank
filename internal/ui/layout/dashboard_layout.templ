package layout

import (
	"github.com/fastygo/blank/internal/kit/ui/box"
	"github.com/fastygo/blank/internal/ui/components/appsidebar"
)

// DashboardLayout wraps TopnavLayout with a desktop aside beside the main column.
// Mobile navigation is inherited from TopnavLayout via the mobile sheet.
templ DashboardLayout(props DashboardLayoutProps) {
	@TopnavLayout(props.Topnav) {
		@box.Box(box.BoxProps{Class: "flex min-h-0 w-full flex-1 flex-col md:flex-row"}) {
			@appsidebar.AppSidebar(props.Sidebar)
			@box.Box(box.BoxProps{Class: "flex min-w-0 flex-1 flex-col"}) {
				{ children... }
			}
		}
	}
}
