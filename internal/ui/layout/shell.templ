package layout

import (
	"github.com/fastygo/blank/internal/ui/components/navigation"
	"github.com/fastygo/templ/ui"
)

templ Shell(props ShellProps) {
	<!DOCTYPE html>
	<html lang={ shellLang(props.Lang) }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ props.Title }</title>
			if props.HeadExtra != nil {
				@props.HeadExtra
			}
		</head>
		<body class={ shellBodyClass(props) }>
			if shellHasNavigation(props) {
				@navigation.MobileSheet(navigation.MobileSheetProps{
					ID:         MobileSheetPanelID,
					TitleID:    navigation.MobileSheetTitleID,
					Title:      shellBrand(props.BrandName),
					AriaLabel:  props.Navigation.NavigationMenuLabel,
					CloseLabel: props.Navigation.CloseNavigationMenu,
					Items:      props.NavItems,
					Active:     props.Active,
				})
			}
			@ui.Box(ui.BoxProps{Class: "flex min-h-screen w-full flex-col"}) {
				@Header(HeaderProps{
					BrandName:       props.BrandName,
					NavItems:        props.NavItems,
					Active:          props.Active,
					ShowMenuTrigger: shellHasNavigation(props),
					Navigation:      props.Navigation,
					Trailing:        props.HeaderTrailing,
					ThemeToggle:     props.ThemeToggle,
				})
				@ui.Block(ui.BlockProps{Tag: "main", Class: "flex w-full min-w-0 max-w-full flex-1 flex-col"}) {
					{ children... }
				}
				@Footer(props.FooterText)
			}
		</body>
	</html>
}
