package appsidebar

import (
	"github.com/fastygo/blank/internal/kit/ui/block"
	"github.com/fastygo/blank/internal/kit/ui/stack"
	"github.com/fastygo/blank/internal/kit/ui/text"
	"github.com/fastygo/blank/internal/ui/components/navigation"
)

// AppSidebar renders the desktop sidebar aside (title + vertical navigation).
// Mobile navigation is served by the shell's mobile sheet — this component is
// hidden below md by its aside class. Rendered inside layout.DashboardLayout.
templ AppSidebar(props Props) {
	@block.Block(block.BlockProps{
		Tag:   "aside",
		Class: asideClass(props.Class),
		Attrs: asideAttrs(props),
	}) {
		@stack.Stack(stack.StackProps{Class: "gap-2 p-4"}) {
			@text.Text(text.TextProps{
				Class: "px-2 text-sm font-semibold text-foreground",
			}) {
				{ props.title() }
			}
			@block.Block(block.BlockProps{Tag: "nav", Class: navClass()}) {
				@navigation.Nav(navigation.NavProps{
					Items:    props.Items,
					Active:   props.Active,
					Vertical: true,
				})
			}
		}
	}
}
