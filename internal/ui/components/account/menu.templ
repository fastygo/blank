package account

import (
	"strings"

	"github.com/fastygo/templ/ui"
)

// MenuProps configures the cabinet sign-out control.
type MenuProps struct {
	Email         string
	SignOutLabel  string
	SignOutAction string
}

templ Menu(props MenuProps) {
	@ui.Form(ui.FormProps{
		Method: "post",
		Action: menuSignOutAction(props.SignOutAction),
		Class:  "flex items-center gap-2",
	}) {
		if strings.TrimSpace(props.Email) != "" {
			@ui.Text(ui.TextProps{Tag: "span", Class: "text-sm text-muted-foreground"}, props.Email)
		}
		@ui.Button(ui.ButtonProps{Type: "submit", Variant: "outline", Size: "sm"}) {
			{ menuSignOutLabel(props.SignOutLabel) }
		}
	}
}

func menuSignOutAction(value string) string {
	if strings.TrimSpace(value) != "" {
		return value
	}
	return "/auth/logout"
}

func menuSignOutLabel(value string) string {
	if strings.TrimSpace(value) != "" {
		return value
	}
	return "Sign out"
}
